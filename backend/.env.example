# Copy this file to .env and adjust the values if needed.

# Port the API listens on
PORT=3000

# Address of the frontend, allowed to call the API
FRONTEND_URL=http://localhost:5173

# PostgreSQL started with "docker compose up -d db" in the project root
DATABASE_URL="postgresql://reptrack:reptrack@localhost:5433/reptrack?schema=public"
# Secret used to sign login tokens. Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
